# @see https://github.com/laravel/laravel/blob/11.x/.env.example for possible values
APP_KEY=

# Web Push (PWA notifications) – generate with: php artisan webpush:vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact info (mailto: or https://) included in the VAPID JWT sent with each push,
# so push services (FCM, Mozilla autopush, etc.) can reach you if your server misbehaves.
VAPID_SUBJECT=mailto:admin@example.com
