APP_NAME="PriceBuddy"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Australia/Melbourne
APP_URL=http://price-buddy.lndo.site

APP_LOCALE=en
APP_CURRENCY_LOCALE=en_US
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# OIDC / Single Sign-On (optional)
# =============================================================================
# Leave all OIDC_* vars unset (or empty) to use only local email/password login.
# Set OIDC_BASE_URL + OIDC_CLIENT_ID + OIDC_CLIENT_SECRET + OIDC_REDIRECT_URI
# to enable OIDC login. See docs/oidc.md for full setup instructions.

# Base URL of your OIDC identity provider (IdP).
# Discovery document is fetched from {OIDC_BASE_URL}/.well-known/openid-configuration
# OIDC_BASE_URL=https://auth.example.com

# OIDC client credentials registered at the IdP
# OIDC_CLIENT_ID=pricebuddy
# OIDC_CLIENT_SECRET=your-secret-here

# Must match the redirect URI registered at the IdP exactly:
# https://<your-pricebuddy-url>/admin/oauth/callback/oidc
# OIDC_REDIRECT_URI=https://pricebuddy.example.com/admin/oauth/callback/oidc

# Space-separated scopes to request (default: "openid profile email")
# OIDC_SCOPES=openid profile email groups

# Set to a group name/value; OIDC users with this group become admins.
# Requires the IdP to emit a groups claim (see docs/oidc.md).
# OIDC_ADMIN_GROUP=pricebuddy-admins

# Name of the claim in the OIDC token that contains the user's groups (default: "groups")
# OIDC_GROUPS_CLAIM=groups

# Label shown on the SSO login button (default: "Single Sign-On")
# OIDC_BUTTON_LABEL=Single Sign-On

# Validate JWT ID-token signatures (default: true, strongly recommended).
# Set to false only if your IdP does not expose a JWKS endpoint.
# OIDC_VERIFY_JWT=true

# Optional: PEM public key for JWT signature verification when OIDC_VERIFY_JWT=true
# and the IdP does not expose a JWKS endpoint.
# OIDC_JWT_PUBLIC_KEY=

# Set to true to disable local email/password login entirely.
# WARNING: ensure OIDC is working before enabling this — recovery requires setting it back to false.
# DISABLE_LOCAL_LOGIN=false
